{
  "$comment": "Reading Training behaviour parity contract v1. Expected-input/expected-output cases the Nostos engine must satisfy, derived from the accepted behaviours of the existing Python reading coach (behaviour oracle only, never a runtime dependency).",
  "version": 1,
  "source": "Python reading coach accepted behaviours",
  "defaults": {
    "enduranceTargetMinutes": 40,
    "deepTargetMinutes": 30,
    "recoveryTargetMinutes": 20
  },
  "states": [
    "Idle",
    "Planned",
    "Active",
    "Paused",
    "AwaitingFeedback",
    "Completed",
    "Cancelled"
  ],
  "cases": [
    {
      "id": "baseline-001",
      "name": "Fresh programme starts with baseline targets",
      "given": { "programme": "fresh" },
      "expect": {
        "enduranceTargetMinutes": 40,
        "deepTargetMinutes": 30,
        "recoveryTargetMinutes": 20
      }
    },
    {
      "id": "state-002",
      "name": "Legal state transitions",
      "given": { "session": "planned" },
      "when": ["start", "pause", "resume", "complete"],
      "expect": { "path": ["Planned", "Active", "Paused", "Active", "AwaitingFeedback"] }
    },
    {
      "id": "open-slot-003",
      "name": "One globally open session; a second open session is rejected",
      "given": { "openSessions": 1 },
      "when": "start second session",
      "expect": { "accepted": false }
    },
    {
      "id": "elapsed-004",
      "name": "Elapsed time excludes pause duration",
      "given": { "activeSeconds": 600, "pausedSeconds": 300 },
      "expect": { "accumulatedSeconds": 600 }
    },
    {
      "id": "report-005",
      "name": "Reported-minutes override preserves measured seconds",
      "given": { "measuredSeconds": 1234, "reportedMinutes": 25 },
      "expect": { "displayMinutes": 25, "measuredSeconds": 1234 }
    },
    {
      "id": "constraint-006",
      "name": "Time-constrained session is volume but not progression evidence",
      "given": { "constraint": "TimeConstrained", "sessionComplete": true },
      "expect": { "countsAsVolume": true, "countsAsEvidence": false }
    },
    {
      "id": "fatigue-007",
      "name": "High fatigue holds or reduces load, never increases it",
      "given": { "fatigue": "high", "weeklyLoad": 60 },
      "when": "weekly adaptation",
      "expect": { "loadDirection": ["hold", "reduce"] }
    },
    {
      "id": "default-008",
      "name": "One default book per mode; other active/queued books allowed",
      "given": { "mode": "Deep", "assignments": ["A", "B", "C"], "defaults": 1 },
      "expect": { "defaultCountPerMode": 1, "activeAllowed": true }
    },
    {
      "id": "book-link-009",
      "name": "Completed session links to exactly one Nostos book",
      "given": { "sessionBookIds": 1 },
      "expect": { "bookCount": 1 }
    },
    {
      "id": "weekly-010",
      "name": "Three qualifying sessions plus completion threshold permit +5",
      "given": { "qualifyingSessions": 3, "completionThresholdMet": true },
      "expect": { "adaptation": "+5", "mode": "independent" }
    },
    {
      "id": "volume-011",
      "name": "15% volume guard bounds the increase",
      "given": { "currentVolume": 60, "proposedVolume": 70 },
      "expect": { "accepted": true, "guard": "within 15%" }
    },
    {
      "id": "review-012",
      "name": "Weekly review commits exactly once per ISO week per mode",
      "given": { "weekKey": "2026-W32", "mode": "Deep" },
      "when": "commit review twice",
      "expect": { "reviewRows": 1, "idempotent": true }
    },
    {
      "id": "command-013",
      "name": "Command retry with same (clientId, idempotencyKey) is exact-once",
      "given": { "clientId": "telegram-7", "idempotencyKey": "k-1" },
      "when": "submit same command twice",
      "expect": { "effects": 1, "duplicateReturnsStoredResult": true }
    },
    {
      "id": "capture-014",
      "name": "Capture retry with same ExternalId creates one capture",
      "given": { "externalId": "tg-msg-99" },
      "when": "submit same capture twice",
      "expect": { "captureRows": 1, "verbatim": true }
    },
    {
      "id": "language-015",
      "name": "No streak, debt, catch-up, guilt, or compulsory reflection language",
      "given": { "replyVocabulary": "accepted replies" },
      "expect": { "forbiddenTerms": ["streak", "debt", "catch-up", "guilt", "compulsory"] }
    }
  ]
}
