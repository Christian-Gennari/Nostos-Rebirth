{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BackupSettings": {
    "IsEnabled": false,
    "IntervalHours": 168,
    "Provider": "Local",
    "MaxBackups": 3,
    "IncludeBookFiles": true
  },
  "Mcp": {
    "Enabled": false,
    "Path": "/mcp",
    "ApiKeyEnvironmentVariable": "NOSTOS_MCP_TOKEN"
  },
  "Speech": {
    "Enabled": false,
    "BaseUrl": "http://omenhub:20128",
    "Model": "groq/whisper-large-v3-turbo",
    "ApiKeyEnvironmentVariable": "NOSTOS_STT_TOKEN",
    "MaxUploadBytes": 26214400,
    "MaxDurationSeconds": 300
  },
  "LibraryReceiptRetention": {
    "RetentionDays": 90,
    "MaximumReceipts": 10000,
    "CleanupIntervalHours": 24
  },
  "Storage": {
    "BooksRoot": null,
    "BackupsRoot": null
  },
  "Media": {
    "FfmpegPath": null,
    "FfprobePath": null,
    "EncodeTimeoutMinutes": 180
  }
}