{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BackupSettings": {
    "IsEnabled": false,
    "IntervalHours": 168,
    "Provider": "Local",
    "MaxBackups": 3,
    "IncludeBookFiles": true
  },
  "Mcp": {
    "Enabled": false,
    "Path": "/mcp",
    "ApiKeyEnvironmentVariable": "NOSTOS_MCP_TOKEN"
  },
  "Speech": {
    "Enabled": true,
    "BaseUrl": "",
    "Model": "groq/whisper-large-v3-turbo",
    "ApiKeyEnvironmentVariable": "NOSTOS_STT_TOKEN",
    "MaxUploadBytes": 26214400,
    "MaxDurationSeconds": 300
  },
  "Assistant": {
    "Enabled": true,
    "BaseUrl": "",
    "Model": "gemini/gemini-3.5-flash-lite",
    "ApiKeyEnvironmentVariable": "NOSTOS_ASSISTANT_TOKEN",
    "MaxToolIterations": 6,
    "RequestTimeoutSeconds": 90
  },
  "CloudManagedAi": {
    "LlmEnabled": true,
    "LlmBaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "LlmModel": "gemini-3.8-flash",
    "LlmThinkingLevel": "low",
    "LlmApiKeyEnvironmentVariable": "NOSTOS_CLOUD_GEMINI_API_KEY",
    "LlmRequestTimeoutSeconds": 90,
    "SttEnabled": true,
    "SttBaseUrl": "https://api.groq.com/openai",
    "SttModel": "whisper-large-v3-turbo",
    "SttApiKeyEnvironmentVariable": "NOSTOS_CLOUD_GROQ_API_KEY",
    "SttRequestTimeoutSeconds": 300
  },
  "LibraryReceiptRetention": {
    "RetentionDays": 90,
    "MaximumReceipts": 10000,
    "CleanupIntervalHours": 24
  },
  "Storage": {
    "BooksRoot": null,
    "BackupsRoot": null
  },
  "Media": {
    "FfmpegPath": null,
    "FfprobePath": null,
    "EncodeTimeoutMinutes": 180
  },
  "CloudAuth": {
    "Authority": "",
    "ClientId": "",
    "Audience": "",
    "ClientSecretEnvironmentVariable": "NOSTOS_CLOUD_AUTH_CLIENT_SECRET",
    "SessionHours": 8
  },
  "CloudControlPlane": {
    "ControlPlaneConnectionStringEnvironmentVariable": "NOSTOS_CLOUD_CONTROL_PLANE_CONNECTION",
    "PostgresAdminConnectionStringEnvironmentVariable": "NOSTOS_CLOUD_POSTGRES_ADMIN_CONNECTION",
    "CustomerConnectionStringEnvironmentVariable": "NOSTOS_CLOUD_POSTGRES_CUSTOMER_CONNECTION",
    "CustomerDatabasePrefix": "nostos_u",
    "StorageNamespacePrefix": "accounts"
  },
  "CloudDataProtection": {
    "KeyEncryptionKeyEnvironmentVariable": "NOSTOS_CLOUD_DATA_PROTECTION_KEY"
  },
  "CloudObjectStorage": {
    "Bucket": "",
    "Region": "auto",
    "ServiceUrl": "",
    "ForcePathStyle": true,
    "AccessKeyEnvironmentVariable": "NOSTOS_CLOUD_OBJECT_STORAGE_ACCESS_KEY",
    "SecretKeyEnvironmentVariable": "NOSTOS_CLOUD_OBJECT_STORAGE_SECRET_KEY"
  },
  "CloudBilling": {
    "Provider": "Paddle",
    "PastDueGraceHours": 72,
    "ReconciliationIntervalMinutes": 15,
    "Plans": [],
    "Paddle": {
      "Environment": "Sandbox",
      "ApiKeyEnvironmentVariable": "NOSTOS_CLOUD_BILLING_PADDLE_API_KEY",
      "WebhookSecretEnvironmentVariable": "NOSTOS_CLOUD_BILLING_PADDLE_WEBHOOK_SECRET",
      "CheckoutUrl": "",
      "PriceMappings": []
    }
  },
  "CloudManagedAiUsage": {
    "OperatorEnabled": true,
    "GlobalMonthlyBudgetMicrousd": 100000000,
    "RateWindowSeconds": 60,
    "LlmRequestsPerWindow": 20,
    "SttRequestsPerWindow": 10,
    "SttReservationSeconds": 300,
    "NearLimitPercent": 80
  }
}
