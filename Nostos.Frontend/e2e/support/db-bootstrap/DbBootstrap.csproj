<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Nostos.E2eDbBootstrap</AssemblyName>
    <RootNamespace>Nostos.E2eDbBootstrap</RootNamespace>
    <!-- Never part of the product: fixture-only console helper. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Read-only dependency on the real backend so the schema and migration
         list always match the backend under test. -->
    <ProjectReference Include="..\..\..\..\Nostos.Backend\Nostos.Backend.csproj" />
  </ItemGroup>

</Project>
